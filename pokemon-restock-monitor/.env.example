# =====================================================================
# Pokémon Restock Monitor -- copy to .env and fill in. NEVER commit .env
# =====================================================================

# --- App ---------------------------------------------------------------
DATABASE_URL=sqlite:///./data/restock.db
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/restock   (pip install psycopg[binary])
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console
# used for "Detected: 4:17:32 PM" in alerts
TIMEZONE=America/New_York
# Protect the dashboard if it's reachable from other machines:
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=

# Identify yourself honestly to retailers (goes into the User-Agent).
CONTACT_EMAIL=you@example.com

# --- Notifications -----------------------------------------------------
# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=
# e.g. @here  or  <@&ROLE_ID>  or  <@USER_ID>
DISCORD_MENTION=
DISCORD_USE_BUTTONS=true
# Phone push via the free ntfy app (optional): install ntfy, subscribe to a
# long random topic name, and put the same name here. Treat it like a password.
NTFY_TOPIC=
# Telegram (optional): token from @BotFather, chat id from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Email (optional)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=
EMAIL_TO=
NOTIFY_CONSOLE=true

# --- Stores --------------------------------------------------------------
# Format: store_id|name|city|state|zip ; separated by semicolons.
# Find a Target store id on target.com's store locator (it's the number in the store page URL).
TARGET_STORES=
# TARGET_STORES=1234|Athens Target|Athens|TN|37303;5678|Cleveland Target|Cleveland|TN|37311;9012|Knoxville Target|Knoxville|TN|37919
# Other retailers: retailer|store_id|name|city|state|zip ; ...
EXTRA_STORES=

# --- Polling (conservative defaults; nothing can go below 15s per product) ---
MONITOR_ENABLED=true
# NORMAL: 90 ± 30 -> 60-120s
POLL_INTERVAL_SECONDS=90
POLL_JITTER_SECONDS=30
# after a stock change: 45 ± 15 -> 30-60s
RECENTLY_ACTIVE_INTERVAL_SECONDS=45
RECENTLY_ACTIVE_JITTER_SECONDS=15
RECENTLY_ACTIVE_WINDOW_MINUTES=30
# after an alert, only watch for the sell-out
AVAILABLE_HOLD_INTERVAL_SECONDS=300
ERROR_BACKOFF_BASE_SECONDS=60
ERROR_BACKOFF_MAX_SECONDS=3600
SCHEDULER_TICK_SECONDS=5
MAX_CONCURRENT_CHECKS=4
STALL_ALERT_MINUTES=30

# --- Rate limiting -----------------------------------------------------------
# per retailer, between ANY two requests
MIN_REQUEST_INTERVAL_SECONDS=5
# transient errors only (timeouts, 5xx); never 429/403
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=15
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=1800
# pause after a CAPTCHA / bot challenge / 403 (6h)
BLOCKED_COOLDOWN_SECONDS=21600
# One-shot mode: at most N products of these retailers per round (Walmart blocks fast checking)
CHECKS_PER_SWEEP=walmart=1

# --- Verification & alert policy ---------------------------------------------
VERIFICATION_DELAY_SECONDS=10
VERIFICATION_CHECKS=1
ACCEPT_THIRD_PARTY=false
ACCEPT_UNKNOWN_SELLER=true
ALERT_ON_LIMITED=true
ALERT_ON_PREORDER=false
ALERT_ON_UNKNOWN_TO_AVAILABLE=true
PENDING_NOTIFICATION_MAX_AGE_MINUTES=15
# Keep reminding you while the item is still in stock: every N minutes, at most M times (0 = off)
RESTOCK_REMINDER_MINUTES=10
RESTOCK_REMINDER_MAX=6

# --- Retailer specific ---------------------------------------------------------
# true = render pages with Playwright (requirements-browser.txt)
TARGET_USE_BROWSER=false

# --- Analytics -------------------------------------------------------------------
ANALYTICS_MIN_EPISODES=5
